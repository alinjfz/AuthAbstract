# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=authdb
POSTGRES_USER=authuser
DB_PASSWORD=CHANGE_ME_strong_password_here

# ── App secret ────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=480
# Set to False for local HTTP dev (non-Docker)
JWT_COOKIE_SECURE=True

# ── Email token salts ─────────────────────────────────────────────────────────
VERIFICATION_SALT=CHANGE_ME_random_string
RESET_PASSWORD_SALT=CHANGE_ME_random_string
EMAIL_TOKEN_EXPIRY=3600

# ── Feature toggles ───────────────────────────────────────────────────────────
EMAIL_VERIFY_ENABLED=False    # True = require email verification on register
MAIL_ENABLED=False            # True = send actual emails (needs MAIL_* below)

# ── Mail (only needed if MAIL_ENABLED=True) ───────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://localhost
FRONTEND_URL=https://localhost
